# ============================================================================
# Weather ETL Pipeline — v1 (Local Docker) environment template
# Copy to .env and fill in your real values. Never commit .env to git.
# ============================================================================

AIRFLOW_UID=50000

# ----------------------------------------------------------------------------
# Weatherstack API
# Sign up for a free account at https://weatherstack.com and paste your key.
# ----------------------------------------------------------------------------
WEATHERSTACK_API_KEY=your_weatherstack_api_key_here

# ----------------------------------------------------------------------------
# Weather PostgreSQL (your data)
# Inside Docker, the host is the service name defined in docker-compose.yaml.
# ----------------------------------------------------------------------------
WEATHER_DB_HOST=weather_postgres
WEATHER_DB_PORT=5432
WEATHER_DB_NAME=weather_db
WEATHER_DB_USER=weather_user
WEATHER_DB_PASSWORD=weather_pass

# ----------------------------------------------------------------------------
# Airflow metadata PostgreSQL (Airflow's internal DB — do not change casually)
# ----------------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow_postgres/airflow
AIRFLOW__CORE__FERNET_KEY=AN7RDIlOUvyzAIxoqsyo1j-CcZAUG6JfymTjKZEfl9Y=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
