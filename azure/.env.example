# ============================================================================
# Azure Weather ETL (v2) — local-dev environment template
# Copy to .env (gitignored) and fill in your real values.
# DO NOT commit the .env file. No real secrets anywhere in this repo.
# ============================================================================

# ----------------------------------------------------------------------------
# Azure subscription & resource group
# ----------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-weather-de-dev
AZURE_LOCATION=eastus

# ----------------------------------------------------------------------------
# Storage account (created by Bicep in step 1 of deploy.md)
# Format: abfss://<container>@<account>.dfs.core.windows.net/<path>
# ----------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_BRONZE_CONTAINER=bronze
AZURE_SILVER_CONTAINER=silver
AZURE_GOLD_CONTAINER=gold
AZURE_CONFIG_CONTAINER=config

# ----------------------------------------------------------------------------
# Databricks
# ----------------------------------------------------------------------------
DATABRICKS_WORKSPACE_URL=
DATABRICKS_SECRET_SCOPE=kv-scope
DATABRICKS_SECRET_KEY=weatherstack-api-key

# ----------------------------------------------------------------------------
# Key Vault
# ----------------------------------------------------------------------------
AZURE_KEY_VAULT_NAME=

# ----------------------------------------------------------------------------
# Weatherstack API
# Stored in Key Vault, not here. This is a placeholder reminder only.
# ----------------------------------------------------------------------------
# WEATHERSTACK_API_KEY is read at runtime via dbutils.secrets.get, NOT from .env.
# To set it: az keyvault secret set --vault-name $AZURE_KEY_VAULT_NAME \
#                                      --name "weatherstack-api-key" \
#                                      --value "your_real_key"
